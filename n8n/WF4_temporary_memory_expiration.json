{
  "name": "WF4 \u2014 Automatic Temporary Memory Expiration",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 2 * * *"
            }
          ]
        }
      },
      "id": "wf4-node-01",
      "name": "Daily Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        100,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// WF4 Node 2: Compute Sweep Timestamps\nconst now = new Date();\nreturn {\n  json: {\n    sweep_reference_time: now.toISOString(),\n    sweep_date: now.toISOString().split('T')[0],\n    execution_id: $execution.id || `cron_${Date.now()}`\n  }\n};"
      },
      "id": "wf4-node-02",
      "name": "Compute Sweep Timestamps",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        320,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.BACKEND_BASE_URL || 'https://anchor-backend.onrender.com' }}/api/memories",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "status",
              "value": "active"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.BACKEND_API_KEY || '' }}"
            },
            {
              "name": "x-internal-key",
              "value": "={{ $env.INTERNAL_API_KEY || 'shakti2_internal_key_for_n8n_webhooks' }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          },
          "retry": {
            "retry": {
              "maxTries": 3,
              "waitBetweenTries": 2000
            }
          }
        }
      },
      "id": "wf4-node-03",
      "name": "Query Active Memories",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        540,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// WF4 Node 4: Verify Expiration Dates & Exclude Permanent Memories\nconst memories = Array.isArray($input.item.json) ? $input.item.json : ($input.item.json.data || []);\nconst refTime = new Date($('Compute Sweep Timestamps').first().json.sweep_reference_time).getTime();\n\n// Defensive Filter:\n// 1. Exclude permanent memories (expires_at is null or undefined)\n// 2. Exclude active memories whose expiration date is in the future\nconst expiredCandidates = memories.filter(mem => {\n  if (!mem.expires_at) return false;\n  const expTime = new Date(mem.expires_at).getTime();\n  return !isNaN(expTime) && expTime <= refTime;\n});\n\nreturn {\n  json: {\n    total_active_scanned: memories.length,\n    verified_expired_count: expiredCandidates.length,\n    expired_memory_ids: expiredCandidates.map(m => m._id || m.id),\n    expired_items: expiredCandidates.map(m => ({\n      memory_id: m._id || m.id,\n      attribute_key: m.attribute_key,\n      expires_at: m.expires_at\n    }))\n  }\n};"
      },
      "id": "wf4-node-04",
      "name": "Verify Expiration & Filter Permanent",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        760,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.verified_expired_count }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "wf4-node-05",
      "name": "Any Valid Expired Items?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        980,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// WF4 Node 6a: Log Clean Run Summary\nreturn {\n  json: {\n    status: \"COMPLETED\",\n    items_expired: 0,\n    message: \"No temporary memories have reached their expiration date in this sweep.\",\n    timestamp: new Date().toISOString()\n  }\n};"
      },
      "id": "wf4-node-06a",
      "name": "Log Clean Run Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        140
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_BASE_URL || 'https://anchor-backend.onrender.com' }}/api/lifecycle/consolidate",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.BACKEND_API_KEY || '' }}"
            },
            {
              "name": "x-internal-key",
              "value": "={{ $env.INTERNAL_API_KEY || 'shakti2_internal_key_for_n8n_webhooks' }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "wf4-node-06b",
      "name": "Execute Backend Consolidation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        420
      ]
    },
    {
      "parameters": {
        "jsCode": "// WF4 Node 7: Compile Final Execution Summary\nconst consolidateRes = $('Execute Backend Consolidation').first().json || {};\nconst verifiedData = $('Verify Expiration & Filter Permanent').first().json || {};\n\nreturn {\n  json: {\n    status: \"SUCCESS\",\n    sweep_timestamp: new Date().toISOString(),\n    active_memories_scanned: verifiedData.total_active_scanned || 0,\n    identified_expired_count: verifiedData.verified_expired_count || 0,\n    backend_expired_marked_stale: consolidateRes.expiredCount || verifiedData.verified_expired_count || 0,\n    backend_archived_count: consolidateRes.archivedCount || 0,\n    active_count_remaining: consolidateRes.activeCount || 0,\n    backend_message: consolidateRes.message || \"Consolidation complete.\",\n    idempotent_sweep: true\n  }\n};"
      },
      "id": "wf4-node-07",
      "name": "Compile Final Execution Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        420
      ]
    }
  ],
  "connections": {
    "Daily Schedule Trigger": {
      "main": [
        [
          {
            "node": "Compute Sweep Timestamps",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Compute Sweep Timestamps": {
      "main": [
        [
          {
            "node": "Query Active Memories",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Query Active Memories": {
      "main": [
        [
          {
            "node": "Verify Expiration & Filter Permanent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Verify Expiration & Filter Permanent": {
      "main": [
        [
          {
            "node": "Any Valid Expired Items?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Any Valid Expired Items?": {
      "main": [
        [
          {
            "node": "Execute Backend Consolidation",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log Clean Run Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Execute Backend Consolidation": {
      "main": [
        [
          {
            "node": "Compile Final Execution Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "1.1.0",
  "meta": {
    "templateCredsSetupCompleted": false,
    "instanceId": "anchor-automation-instance"
  },
  "tags": [
    {
      "name": "ANCHOR"
    },
    {
      "name": "Lifecycle"
    },
    {
      "name": "Expiration"
    },
    {
      "name": "Consolidation"
    }
  ]
}