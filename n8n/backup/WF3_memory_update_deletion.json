        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"user_id\": \"{{ $('Validate Command Payload').first().json.body.user_id }}\",\n  \"fields_to_update\": {{ $json.text || $json.response }},\n  \"audit_reason\": \"User natural language modification via WF3.\"\n}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "wf3-node-09a",
      "name": "Execute Backend Patch",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1680,
        420
      ]
    },
    {
      "parameters": {
        "method": "DELETE",
        "url": "={{ $env.BACKEND_BASE_URL || 'https://api.anchor.internal' }}/api/v1/memories/{{ $json.target_memory.memory_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.BACKEND_API_KEY || 'PLACEHOLDER_SERVICE_KEY' }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"user_id\": \"{{ $('Validate Command Payload').first().json.body.user_id }}\",\n  \"reason\": \"User explicit delete/forget command via WF3.\",\n  \"purge_vectors\": true\n}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "wf3-node-09b",
      "name": "Execute Soft-Delete",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        740
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_BASE_URL || 'https://api.anchor.internal' }}/api/v1/audit/logs",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.BACKEND_API_KEY || 'PLACEHOLDER_SERVICE_KEY' }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"workflow\": \"WF3-MANAGEMENT\",\n  \"user_id\": \"{{ $('Validate Command Payload').first().json.body.user_id }}\",\n  \"timestamp\": \"{{ new Date().toISOString() }}\",\n  \"details\": {{ JSON.stringify($json) }}\n}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "wf3-node-10",
      "name": "Record Operation Audit Log",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1920,
        560
      ]
    },
    {
      "parameters": {
        "jsCode": "// WF3 Node 11: Format Success Response\nconst isDelete = $('Match Status Switch').first().json.match_status === 'EXACT_DELETE';\nconst targetMem = $('Evaluate Ambiguity & Match').first().json.target_memory || {};\n\nreturn {\n  json: {\n    success: true,\n    action_required: \"NONE\",\n    operation: isDelete ? \"DELETE\" : \"UPDATE\",\n    memory_id: targetMem.memory_id,\n    topic: targetMem.topic,\n    message: isDelete\n      ? \"Memory successfully deleted and evicted from active retrieval.\"\n      : \"Memory successfully updated and re-indexed.\",\n    timestamp: new Date().toISOString()\n  }\n};"
      },
      "id": "wf3-node-11",
      "name": "Format Success Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2140,
        560
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {
          "responseCode": 200
        }
      },
