{
  "name": "WF3 - Adversarial Quarantine Security Notice",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "quarantine-notice",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "wf3-node-01",
      "name": "Webhook - Quarantine Event",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [100, 300],
      "webhookId": "engram-quarantine-notice"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-has-notify-url",
              "leftValue": "={{ ($vars.NOTIFY_WEBHOOK_URL || '').trim() }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "wf3-node-02",
      "name": "IF Notify URL Configured",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [340, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.NOTIFY_WEBHOOK_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ event: 'quarantine_alert', alert: 'Adversarial memory quarantined by trust gate', memoryId: $json.memoryId, reason: $json.reason, risk: $json.risk, timestamp: new Date().toISOString() }) }}",
        "options": {}
      },
      "id": "wf3-node-03",
      "name": "HTTP Request - Notify Operator",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [580, 200]
    }
  ],
  "connections": {
    "Webhook - Quarantine Event": {
      "main": [
        [
          {
            "node": "IF Notify URL Configured",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF Notify URL Configured": {
      "main": [
        [
          {
            "node": "HTTP Request - Notify Operator",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
