# ==============================================================================
# ENGRAM / ANCHOR Environment Configuration Template
# All secret values must remain blank in this template.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=

# Storage Engine: 'memory' or 'mongo'
STORE=memory

# Embedding Configuration: 'openai' (1536 dims) or 'local' (384 dims)
EMBED_PROVIDER=local
EMBED_MODEL=all-MiniLM-L6-v2
EMBED_DIMS=384

# Authentication & Security
JWT_SECRET=
ENGRAM_SHARED_SECRET=
WEBHOOK_SECRET=
INTERNAL_API_KEY=
ADMIN_SECRET=

# Google OAuth (Google Identity Services)
GOOGLE_CLIENT_ID=

# MongoDB Atlas Configuration (Required when STORE=mongo)
MONGODB_URI=
MONGODB_DB=anchor
MONGODB_DB_NAME=anchor

# AI / LLM API Keys
OPENAI_API_KEY=
LLM_MODEL_FAST=
LLM_MODEL_SMART=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# External Automation & Human Approval (n8n & Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
N8N_BASE_URL=
N8N_WEBHOOK_URL=
N8N_WEBHOOK_ALERT=
N8N_WEBHOOK_DEPLOY=
N8N_WEBHOOK_QUARANTINE=
