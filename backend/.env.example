# ==============================================================================
# ANCHOR Backend Environment Configuration
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Storage Engine: 'memory' for Phases 1-6 (pure in-memory), 'mongo' for Phase 7
STORE=memory

# Authentication & Security
JWT_SECRET=anchor_dev_jwt_secret_change_in_production_key_2026
INTERNAL_API_KEY=shakti2_internal_key_for_n8n_webhooks

# MongoDB Atlas Configuration (Required when STORE=mongo)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/anchor?retryWrites=true&w=majority
MONGODB_DB_NAME=anchor

# AI / LLM API Keys (Placeholders - Add your real keys below)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY_HERE
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_OPTIONAL

# External Automation & Human Approval (n8n & Telegram)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID_HERE
N8N_WEBHOOK_URL=http://localhost:5678/webhook/anchor-alert
